{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "regions": ["gru1"],
  "functions": { "api/commerce.ts": { "maxDuration": 300 } },
  "rewrites": [
    { "source": "/api/:__commerce_route*", "destination": "/api/commerce" },
    { "source": "/gestao/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/versao-a.html", "destination": "/", "permanent": false },
    { "source": "/versao-b.html", "destination": "/?visual=editorial", "permanent": false }
  ],
  "crons": [{ "path": "/api/maintenance", "schedule": "0 7 * * *" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
  ]}]
}
